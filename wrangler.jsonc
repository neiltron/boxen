{
  "name": "pi-durable-sessions",
  "main": "src/index.js",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat"],
  // One Sandbox container per session: where the agent's bash and files live.
  "containers": [
    { "class_name": "Sandbox", "image": "./Dockerfile", "instance_type": "basic", "max_instances": 8 }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "DIRECTORY", "class_name": "Directory" },
      { "name": "SESSION", "class_name": "Session" },
      { "name": "Sandbox", "class_name": "Sandbox" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Directory", "Session", "Sandbox"] }
  ]
}
