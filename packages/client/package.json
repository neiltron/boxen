{
  "name": "@pi-durable-sessions/client",
  "private": true,
  "type": "module",
  "description": "The API contract (openapi.json) and a typed client for it, for the browser and Node",
  "exports": {
    ".": "./src/index.ts",
    "./openapi.json": "./openapi.json"
  },
  "scripts": {
    "generate": "openapi-typescript openapi.json -o src/openapi.ts",
    "check": "openapi-typescript openapi.json -o src/openapi.ts --check && tsc"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "typescript": "~6.0.2"
  }
}
