{
  "runtime": "1.0.0",
  "root": 1,
  "schema": [
    {
      "type": "table",
      "name": "conversations",
      "sql": "CREATE TABLE conversations (\n\t\tid INTEGER PRIMARY KEY,\n\t\towner_conversation_id INTEGER,\n\t\towner_task_id INTEGER,\n\t\trecord TEXT NOT NULL CHECK (json_valid(record))\n\t) STRICT"
    },
    {
      "type": "table",
      "name": "document_revisions",
      "sql": "CREATE TABLE document_revisions (\n\t\tdocument_id INTEGER NOT NULL,\n\t\tseq INTEGER NOT NULL,\n\t\tkind TEXT NOT NULL CHECK (kind IN ('base', 'delta')),\n\t\tversion INTEGER NOT NULL,\n\t\tcontent TEXT NOT NULL CHECK (json_valid(content)),\n\t\tPRIMARY KEY (document_id, seq)\n\t) STRICT"
    },
    {
      "type": "table",
      "name": "documents",
      "sql": "CREATE TABLE documents (\n\t\tid INTEGER PRIMARY KEY,\n\t\tkind TEXT NOT NULL,\n\t\tfamily INTEGER NOT NULL CHECK (family IN (0, 1)),\n\t\tkey_value TEXT NOT NULL,\n\t\tscope_kind TEXT NOT NULL CHECK (scope_kind IN ('session', 'conversation', 'task')),\n\t\towner_id INTEGER NOT NULL,\n\t\tcreated_at INTEGER NOT NULL,\n\t\tretired_at INTEGER,\n\t\trecord TEXT NOT NULL CHECK (json_valid(record))\n\t) STRICT"
    },
    {
      "type": "table",
      "name": "durable_metadata",
      "sql": "CREATE TABLE durable_metadata (\n\t\tsingleton INTEGER PRIMARY KEY CHECK (singleton = 1),\n\t\tnext_id TEXT NOT NULL,\n\t\tnext_seq INTEGER NOT NULL\n\t) STRICT"
    },
    {
      "type": "table",
      "name": "durable_schema",
      "sql": "CREATE TABLE durable_schema (\n\t\t\tsingleton INTEGER PRIMARY KEY CHECK (singleton = 1),\n\t\t\tversion INTEGER NOT NULL CHECK (version >= 0)\n\t\t) STRICT"
    },
    {
      "type": "table",
      "name": "entries",
      "sql": "CREATE TABLE entries (\n\t\tid INTEGER PRIMARY KEY,\n\t\tconversation_id INTEGER NOT NULL,\n\t\thead INTEGER,\n\t\tcommit_seq INTEGER NOT NULL,\n\t\trecord TEXT NOT NULL CHECK (json_valid(record))\n\t) STRICT"
    },
    {
      "type": "table",
      "name": "record_ids",
      "sql": "CREATE TABLE record_ids (\n\t\tid INTEGER PRIMARY KEY,\n\t\trecord_type TEXT NOT NULL CHECK (record_type IN ('conversation', 'entry', 'task', 'submission', 'document'))\n\t) STRICT"
    },
    {
      "type": "table",
      "name": "submissions",
      "sql": "CREATE TABLE submissions (\n\t\tid INTEGER PRIMARY KEY,\n\t\tconversation_id INTEGER NOT NULL,\n\t\trequest_id TEXT,\n\t\tstatus TEXT NOT NULL CHECK (status IN ('queued', 'placed', 'done', 'unanswered')),\n\t\trecord TEXT NOT NULL CHECK (json_valid(record))\n\t) STRICT"
    },
    {
      "type": "table",
      "name": "tasks",
      "sql": "CREATE TABLE tasks (\n\t\tid INTEGER PRIMARY KEY,\n\t\tconversation_id INTEGER NOT NULL,\n\t\tkind TEXT NOT NULL,\n\t\tstatus TEXT NOT NULL CHECK (status IN ('pending', 'running', 'waiting', 'completing', 'terminal')),\n\t\tabort_requested INTEGER NOT NULL CHECK (abort_requested IN (0, 1)),\n\t\tbackground INTEGER NOT NULL CHECK (background IN (0, 1)),\n\t\trecord TEXT NOT NULL CHECK (json_valid(record))\n\t) STRICT"
    },
    {
      "type": "index",
      "name": "conversations_by_owner_conversation",
      "sql": "CREATE INDEX conversations_by_owner_conversation ON conversations (owner_conversation_id, id)"
    },
    {
      "type": "index",
      "name": "conversations_by_owner_task",
      "sql": "CREATE INDEX conversations_by_owner_task ON conversations (owner_task_id, id)"
    },
    {
      "type": "index",
      "name": "document_revisions_by_kind",
      "sql": "CREATE INDEX document_revisions_by_kind ON document_revisions (document_id, kind, seq DESC)"
    },
    {
      "type": "index",
      "name": "documents_by_address",
      "sql": "CREATE INDEX documents_by_address\n\t\tON documents (kind, scope_kind, owner_id, family, key_value, created_at DESC, retired_at)"
    },
    {
      "type": "index",
      "name": "documents_by_scope",
      "sql": "CREATE INDEX documents_by_scope ON documents (scope_kind, owner_id, id)"
    },
    {
      "type": "index",
      "name": "documents_by_scope_kind",
      "sql": "CREATE INDEX documents_by_scope_kind ON documents (scope_kind, owner_id, kind, id)"
    },
    {
      "type": "index",
      "name": "entries_by_conversation",
      "sql": "CREATE INDEX entries_by_conversation ON entries (conversation_id, id DESC)"
    },
    {
      "type": "index",
      "name": "entry_heads_by_conversation",
      "sql": "CREATE INDEX entry_heads_by_conversation ON entries (conversation_id, id DESC) WHERE head IS NOT NULL"
    },
    {
      "type": "index",
      "name": "submissions_by_conversation",
      "sql": "CREATE INDEX submissions_by_conversation ON submissions (conversation_id, id)"
    },
    {
      "type": "index",
      "name": "submissions_by_request",
      "sql": "CREATE INDEX submissions_by_request ON submissions (conversation_id, request_id)"
    },
    {
      "type": "index",
      "name": "submissions_by_status",
      "sql": "CREATE INDEX submissions_by_status ON submissions (status, id)"
    },
    {
      "type": "index",
      "name": "tasks_by_abort_requested",
      "sql": "CREATE INDEX tasks_by_abort_requested ON tasks (abort_requested, id)"
    },
    {
      "type": "index",
      "name": "tasks_by_background",
      "sql": "CREATE INDEX tasks_by_background ON tasks (background, id)"
    },
    {
      "type": "index",
      "name": "tasks_by_conversation",
      "sql": "CREATE INDEX tasks_by_conversation ON tasks (conversation_id, id)"
    },
    {
      "type": "index",
      "name": "tasks_by_kind",
      "sql": "CREATE INDEX tasks_by_kind ON tasks (kind, id)"
    },
    {
      "type": "index",
      "name": "tasks_by_status",
      "sql": "CREATE INDEX tasks_by_status ON tasks (status, id)"
    }
  ],
