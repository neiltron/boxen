    "@fontsource-variable/montserrat": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@pi-durable-sessions/client": "workspace:*",
    "@pierre/diffs": "^1.5.1",
    "@shadcn/react": "^0.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "ghostty-web": "^0.4.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.19.0",
