{
  "name": "@pi-durable-sessions/ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test:workspace": "playwright test --config workspace.playwright.config.ts",
    "preview": "vite preview",
